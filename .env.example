# Copie para .env.local e preencha com os valores de `npx supabase status` (local)
# ou do painel do Supabase (produção). Nunca faça commit do .env.local.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

